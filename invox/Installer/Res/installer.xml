	<Style name="btn_primary" value="height=&quot;44&quot; font=&quot;6&quot; disabledtextcolor=&quot;#FF769084&quot; bkcolor=&quot;#FF009966&quot; hotbkcolor=&quot;#FF00B87A&quot; disabledbkcolor=&quot;#80009966&quot; borderround=&quot;22,22&quot;" />
