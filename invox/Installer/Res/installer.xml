	<VerticalLayout bkcolor="#FF131D29">
		<!--	标题栏	-->
		<HorizontalLayout name="titlebar" height="44" childvalign="vcenter" bkcolor="#FF172433">
			<Label text="installer_title" resourcetext="true" font="1" padding="10,0,0,0" />
			<!-- <Button name="minbtn" width="30" height="26" text="-" font="2" textcolor="#FFAAAAAA" hottextcolor="#FFFFFFFF" padding="0,5,0,0" />	-->
			<Button name="closebtn" width="16" height="16" normalimage="images\close.png" hotimage="images\close_hot.png" padding="0,0,10,0" />
		</HorizontalLayout>
		<!--	第一页：快速安装页面	-->
		<VerticalLayout name="page1">
			<!--	Logo	-->
			<VerticalLayout childalign="center" childvalign="bottom">
				<Control width="300" height="88" bkimage="IMG_LOGO" />
				<Label height="40" text="welcome_text" resourcetext="true" font="2" align="center" />
			</VerticalLayout>
			<!--	安装按钮	-->
			<HorizontalLayout childalign="center">
				<Button name="quick_install_btn" text="install_now" resourcetext="true" style="btn_primary" width="240" height="44" padding="0,40,0,0"/>
			</HorizontalLayout>
			<!--	底部：切换自定义安装和协议	-->
			<HorizontalLayout height="26" childvalign="bottom" padding="0,10,10,6">
				<HorizontalLayout name="agree_area" childvalign="vcenter" padding="10,0,0,0">
					<CheckBox name="agree_check" />
					<Button name="agree_label" text="agree_prefix" resourcetext="true" style="text_primary" font="0" hottextcolor="#FFFFFFFF" autocalcwidth="true" padding="5,0,0,0" userdata="agree_check" />
					<Button name="privacy_link" text="privacy_text" resourcetext="true" style="text_link" font="0" autocalcwidth="true" padding="2,0,0,0" cursor="hand" />
				</HorizontalLayout>
				<Button name="switch_custom_btn" text="custom_install" resourcetext="true" style="text_primary" font="0" hottextcolor="#FFFFFFFF" autocalcwidth="true" />
			</HorizontalLayout>
		</VerticalLayout>
		<!--	第二页：自定义安装页面	-->
		<VerticalLayout name="page2" visible="false">
			<!--	Logo	-->
			<VerticalLayout height="190" childalign="center" childvalign="vcenter" bkcolor="#FF172433">
				<Control width="270" height="79" bkimage="IMG_LOGO" />
				<Label text="welcome_text" resourcetext="true" font="2" align="center" height="40" />
			</VerticalLayout>
			<VerticalLayout padding="30,0,30,0">
				<!--	自定义选项	-->
				<VerticalLayout childalign="center" childvalign="vcenter">
					<!--	自定义路径区域	-->
					<HorizontalLayout height="26" childvalign="vcenter">
						<Label text="install_path" width="60" resourcetext="true" style="text_secondary" font="0" autocalcwidth="true" />
						<Edit name="path_edit" width="200" />
						<Button name="browse_btn" padding="10,0,10,0" width="16" height="16" font="0" normalimage="images\folder.png" hotimage="images\folder_hot.png" pushedimage="images\folder_hot.png" borderround="3,3" cursor="hand" />
					</HorizontalLayout>
					<Control height="20" />
					<!--	安装按钮	-->
					<Button name="custom_install_btn" text="install_now" resourcetext="true" style="btn_primary" width="240" height="44" />
					<!--	桌面快捷方式	-->
					<HorizontalLayout height="26" childalign="center" childvalign="vcenter" padding="0,6,0,0">
						<CheckBox name="desktop_check" />
						<Button name="desktop_label" text="desktop_shortcut" resourcetext="true" style="text_primary" font="0" hottextcolor="#FFFFFFFF" autocalcwidth="true" padding="5,0,0,0" userdata="desktop_check" />
					</HorizontalLayout>
				</VerticalLayout>
			</VerticalLayout>
			<!--	底部：切换快速安装和协议	-->
			<HorizontalLayout height="26" childvalign="vcenter" padding="0,10,10,6">
				<HorizontalLayout name="agree_area2" childvalign="vcenter" padding="10,0,0,0">
					<CheckBox name="agree_check_custom" />
					<Button name="agree_label_custom" text="agree_prefix" resourcetext="true" style="text_primary" font="0" hottextcolor="#FFFFFFFF" autocalcwidth="true" padding="5,0,0,0" userdata="agree_check_custom" />
					<Button name="privacy_link_custom" text="privacy_text" resourcetext="true" style="text_link" font="0" autocalcwidth="true" padding="2,0,0,0" cursor="hand" />
				</HorizontalLayout>
				<Button name="switch_quick_btn" text="quick_install" resourcetext="true" style="text_primary" font="0" hottextcolor="#FFFFFFFF" autocalcwidth="true" cursor="hand" />
			</HorizontalLayout>
		</VerticalLayout>
		<!--	第三页：安装进度页面	-->
		<VerticalLayout name="page3" padding="30,30,30,30" visible="false">
			<VerticalLayout childvalign="vcenter">
				<!--	进度条	-->
				<Progress name="install_progress" />
				<Control height="20" />
				<!--	进度文本	-->
				<Text name="progress_text" text="installing" resourcetext="true" style="text_secondary" height="40" font="0" align="center" />
			</VerticalLayout>
		</VerticalLayout>
		<!--	第四页：安装完成页面	-->
		<VerticalLayout name="page4" visible="false">
			<!--	立即打开按钮	-->
			<VerticalLayout childalign="center" childvalign="vcenter" padding="0,0,0,36">
				<Control width="120" height="120" bkimage="images\success.png" />
				<Button name="launch_btn" text="launch_now" resourcetext="true" width="240" height="44" padding="0,40,0,0" style="btn_primary" />
			</VerticalLayout>
		</VerticalLayout>
	</VerticalLayout>
</Window>
