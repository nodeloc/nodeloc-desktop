	<VerticalLayout bkcolor="#FF131D29">
		<!-- 标题栏	-->
		<HorizontalLayout name="titlebar" height="44" childvalign="vcenter" bkcolor="#FF172433">
			<Label text="uninstaller_title" resourcetext="true" font="1" padding="10,0,0,0" />
			<!-- <Button name="minbtn" width="30" height="26" text="-" font="2" textcolor="#FFAAAAAA" hottextcolor="#FFFFFFFF" padding="0,5,0,0" />	-->
			<Button name="closebtn" width="16" height="16" normalimage="images\close.png" hotimage="images\close_hot.png" padding="0,0,10,0" />
		</HorizontalLayout>
		<!-- 第一页：反馈页面	-->
		<VerticalLayout name="page1" padding="30,30,30,30" visible="true">
			<!--	Logo	-->
			<VerticalLayout childalign="center" childvalign="vcenter">
				<Control width="270" height="79" bkimage="IMG_LOGO" />
				<Label height="40" text="welcome_text" resourcetext="true" font="2" align="center" />
			</VerticalLayout>
			<VerticalLayout height="200">
				<!-- 卸载原因	-->
				<VerticalLayout height="60">
					<Label text="reason_label" resourcetext="true" style="text_secondary" font="1" height="25" />
					<HorizontalLayout height="26">
						<HorizontalLayout height="26" childvalign="vcenter">
							<Option name="reason1" group="reason" selected="true" style="radio" />
							<Button text="reason1_text" resourcetext="true" style="text_primary" padding="5,0,0,0" font="0" hottextcolor="#FFFFFFFF" autocalcwidth="true" userdata="reason1" />
						</HorizontalLayout>
						<HorizontalLayout height="26" childvalign="vcenter">
							<Option name="reason2" group="reason" style="radio" />
							<Button text="reason2_text" resourcetext="true" style="text_primary" padding="5,0,0,0" font="0" hottextcolor="#FFFFFFFF" autocalcwidth="true" userdata="reason2" />
						</HorizontalLayout>
						<HorizontalLayout height="26" childvalign="vcenter">
							<Option name="reason3" group="reason" style="radio" />
							<Button text="reason3_text" resourcetext="true" style="text_primary" padding="5,0,0,0" font="0" hottextcolor="#FFFFFFFF" autocalcwidth="true" userdata="reason3" />
						</HorizontalLayout>
					</HorizontalLayout>
				</VerticalLayout>
				<!-- 用户反馈	-->
				<VerticalLayout>
					<Label text="feedback_label" resourcetext="true" font="1" style="text_secondary" />
					<RichEdit name="feedback_edit" />
				</VerticalLayout>
			</VerticalLayout>
			<!-- 卸载按钮	-->
			<HorizontalLayout height="40" childalign="center">
				<Button name="uninstall_btn" text="uninstall_btn" resourcetext="true" style="btn_primary" width="240" height="44" />
			</HorizontalLayout>
		</VerticalLayout>
		<!-- 第二页：卸载进度页面	-->
		<VerticalLayout name="page2" padding="30, 30, 30, 30" visible="false">
			<!--	Logo	-->
			<VerticalLayout childalign="center" childvalign="vcenter">
				<Control width="270" height="79" bkimage="IMG_LOGO" />
				<Label height="40" text="welcome_text" resourcetext="true" font="2" align="center" />
			</VerticalLayout>
			<!-- 进度条和进度文本	-->
			<VerticalLayout>
				<Progress name="uninstall_progress" />
				<Control height="20" />
				<Text name="progress_text" text="uninstalling" resourcetext="true" style="text_secondary" height="40" font="0" align="center" />
			</VerticalLayout>
		</VerticalLayout>
		<!-- 第三页：卸载完成页面	-->
		<VerticalLayout name="page3" padding="30,30,30,30" visible="false">
			<!--	Logo	-->
			<VerticalLayout childalign="center" childvalign="vcenter">
				<Control width="270" height="79" bkimage="IMG_LOGO" />
				<Label height="40" text="welcome_text" resourcetext="true" font="2" align="center" />
			</VerticalLayout>
			<!-- 完成文本	-->
			<VerticalLayout>
				<Label name="complete_text" text="uninstall_complete" align="center" resourcetext="true" style="text_primary" font="1" />
				<Control height="40" />
				<!-- 再见按钮	-->
				<HorizontalLayout height="40" childalign="center">
					<Button name="goodbye_btn" text="goodbye_btn" resourcetext="true" style="btn_primary" width="240" height="44" />
				</HorizontalLayout>
			</VerticalLayout>
		</VerticalLayout>
	</VerticalLayout>
</Window>
