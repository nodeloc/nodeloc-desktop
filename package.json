{
  "name": "nodeloc-desktop",
  "productName": "NodeLoc",
  "version": "0.1.0",
  "description": "NodeLoc 社区 Windows 桌面客户端",
  "author": "NodeLoc",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "node scripts/prepare-dev-electron.cjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:media-embeds": "node tests/run-media-embeds.cjs",
    "test:topic-reader": "node tests/run-topic-reader.cjs",
    "test:checkin": "node tests/run-checkin.cjs && node tests/run-topic-reader.cjs checkin",
    "test:reactions": "node tests/run-topic-reader.cjs reactions",
    "test:feed-compact": "node tests/run-topic-reader.cjs feed-compact",
    "package:unpacked": "npm run build && electron-builder --dir --win --x64",
    "package:nsis": "npm run build && electron-builder --win --x64",
    "package:invox": "npm run package:unpacked && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-invox.ps1",
    "package": "npm run package:invox"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "dompurify": "^3.4.15",
    "highlight.js": "^11.12.0",
    "hls.js": "^1.7.3",
    "html-react-parser": "^6.1.7",
    "i18next": "^26.4.2",
    "katex": "^0.18.7",
    "lucide-react": "^1.45.0",
    "markdown-it": "^15.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.13",
    "react-router": "^8.3.1",
    "react-virtuoso": "^4.18.13",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
